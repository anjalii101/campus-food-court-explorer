# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# .env is read in every profile except "prod". Select the profile in the real environment, e.g.
#   PowerShell: $env:SPRING_PROFILES_ACTIVE = "local"
# (a profile set inside .env itself is not applied).

# Dedicated development database (NOT the legacy "campusfoodcourt" database, which is always refused)
DB_URL=jdbc:postgresql://localhost:5432/campusfoodcourt_dev
DB_USERNAME=cfc_app
DB_PASSWORD=change-me

# Base64 HMAC key, >= 32 bytes decoded. Generate with:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   Bash:       openssl rand -base64 48
JWT_SECRET=

# Optional overrides
# JWT_ACCESS_TOKEN_TTL_MS=900000
# REFRESH_TOKEN_TTL=P7D          # rolling inactivity limit, renewed on every refresh
# BCRYPT_STRENGTH=12
# AUTH_COOKIE_SECURE=true        # keep true; browsers accept Secure cookies on http://localhost
# AUTH_COOKIE_SAME_SITE=Strict   # Strict | Lax | None (None requires Secure)
# DB_PROTECTED_NAMES=            # extra databases to refuse, in addition to campusfoodcourt

# Authentication rate limits, per client address (see docs/authentication.md)
# AUTH_RATE_LIMIT_LOGIN_MAX_REQUESTS=20      # per AUTH_RATE_LIMIT_LOGIN_WINDOW
# AUTH_RATE_LIMIT_LOGIN_WINDOW=PT1M
# AUTH_RATE_LIMIT_REGISTER_MAX_REQUESTS=20   # per AUTH_RATE_LIMIT_REGISTER_WINDOW
# AUTH_RATE_LIMIT_REGISTER_WINDOW=PT10M
# AUTH_RATE_LIMIT_REFRESH_MAX_REQUESTS=60    # per AUTH_RATE_LIMIT_REFRESH_WINDOW
# AUTH_RATE_LIMIT_REFRESH_WINDOW=PT1M
# AUTH_RATE_LIMIT_MAX_TRACKED_CLIENTS=20000  # per endpoint; bounds memory
# AUTH_RATE_LIMIT_IPV6_PREFIX_LENGTH=64
